
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FarmLink Security Rules
     * Optimized for prototyping and clear party-based access.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profiles.
     */
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /syncQueue/{queueEntryId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /**
     * @description Marketplace crop listings. 
     * Publicly readable by all authenticated users.
     * Writable only by the owner (farmer).
     */
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.farmerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.farmerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.farmerId == request.auth.uid;
    }

    /**
     * @description Order documents.
     * Readable by any party involved in the transaction (Farmer, Buyer, or Transporter)
     * OR if the order is seeking a transporter (transporterId is null).
     */
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.farmerId == request.auth.uid || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.transporterId == request.auth.uid ||
        resource.data.transporterId == null
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.farmerId == request.auth.uid || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.transporterId == request.auth.uid ||
        resource.data.transporterId == null
      );

      allow delete: if isSignedIn() && (
        resource.data.farmerId == request.auth.uid || 
        resource.data.buyerId == request.auth.uid
      );
    }
  }
}
