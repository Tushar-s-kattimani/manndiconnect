
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FarmLink Security Rules
     * Optimized for collaborative marketplace prototyping.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description User profiles and private sync queues.
     */
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /syncQueue/{queueEntryId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /**
     * @description Marketplace crop listings.
     * Collaborative: Farmers create them, Retailers mark them as 'Sold' during purchase.
     */
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Allow update for authenticated users to facilitate 'Sold' status changes by retailers
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.farmerId == request.auth.uid;
    }

    /**
     * @description Orders and Transport Jobs.
     * Writable by any authenticated party to allow for multi-party updates (Farmer, Buyer, Transporter).
     */
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
