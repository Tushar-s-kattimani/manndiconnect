rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FarmLink Security Rules
     * 
     * Philosophy: Prototyping Mode.
     * This ruleset enforces strict authorization based on user roles and document ownership 
     * while remaining flexible on the specific data schema to allow for rapid iteration.
     * 
     * Data Structure:
     * - /users/{userId}: Primary user profiles for Farmers, Retailers, and Transporters.
     * - /listings/{listingId}: Crop listings created by Farmers, viewable by all authenticated users.
     * - /orders/{orderId}: Shared transactional documents involving a Farmer, Buyer (Retailer), and Transporter.
     * - /users/{userId}/syncQueue/{queueId}: Private user-specific operation logs for offline synchronization.
     * 
     * Key Security Decisions:
     * - Authorization Independence: Documents (Listings, Orders) include denormalized UIDs (farmerId, buyerId) 
     *   to allow for fast, direct security checks without cross-document lookups.
     * - Hierarchical Isolation: User-specific data (profiles, sync queues) are secured via path-based 
     *   ownership checks (request.auth.uid == userId).
     * - Shared Access: Orders are accessible only to the specific participants defined within 
     *   the document fields, supporting secure multi-party workflows.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the authenticated user is a participant in an order. */
    function isOrderParticipant(data) {
      return isSignedIn() && (
        request.auth.uid == data.farmerId || 
        request.auth.uid == data.buyerId || 
        ('transporterId' in data && request.auth.uid == data.transporterId)
      );
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profiles. Access restricted to the profile owner.
     * @path /users/{userId}
     * @allow (get) request.auth.uid == 'user_123'
     * @deny (create) request.auth.uid == 'user_123' but data.id == 'user_456'
     * @principle Path-based ownership and relational integrity.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if resource != null && isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if resource != null && isOwner(userId);

      /**
       * @description Private synchronization queue for offline-first capabilities.
       * @path /users/{userId}/syncQueue/{queueEntryId}
       * @allow (create) authenticated user writes to their own subcollection.
       * @deny (list) user_A attempts to list user_B's sync queue.
       * @principle Structural segregation of private user data.
       */
      match /syncQueue/{queueEntryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if resource != null && isOwner(userId);
        allow delete: if resource != null && isOwner(userId);
      }
    }

    /**
     * @description Marketplace crop listings. Publicly readable by users; writable only by the creating farmer.
     * @path /listings/{listingId}
     * @allow (list) any authenticated user browsing the marketplace.
     * @allow (update) the farmer who owns the listing.
     * @deny (create) user_A attempts to set 'farmerId' to user_B.
     * @principle Public read with owner-only writes via denormalized ownership field.
     */
    match /listings/{listingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.farmerId == request.auth.uid;
      allow update: if resource != null && request.auth.uid == resource.data.farmerId && request.resource.data.farmerId == resource.data.farmerId;
      allow delete: if resource != null && request.auth.uid == resource.data.farmerId;
    }

    /**
     * @description Shared order documents. Accessible by the specific farmer, buyer, and transporter involved.
     * @path /orders/{orderId}
     * @allow (get) any of the three participants (farmer, buyer, transporter).
     * @allow (create) a buyer creating an order linked to their own UID.
     * @deny (update) a user who is not listed as a participant in the order.
     * @principle Shared access via closed collaborators (UID mapping).
     */
    match /orders/{orderId} {
      allow get, list: if isOrderParticipant(resource.data);
      allow create: if isSignedIn() && (request.resource.data.buyerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid);
      allow update: if resource != null && isOrderParticipant(resource.data) && request.resource.data.buyerId == resource.data.buyerId && request.resource.data.farmerId == resource.data.farmerId;
      allow delete: if resource != null && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.farmerId);
    }
  }
}